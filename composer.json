{
    "name": "alex-kassel/workspace-manifest",
    "description": "Domain manifest repository and schema for multi-package workspace.json configurations",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "workspace",
        "manifest",
        "packages",
        "monorepo"
    ],
    "authors": [
        {
            "name": "Alex Kassel",
            "role": "Developer"
        }
    ],
    "bin": [
        "bin/workspace"
    ],
    "require": {
        "php": "^8.2|^8.3",
        "alex-kassel/manifest-engine": "^0.0.5",
        "alex-kassel/stub-engine": "^0.0.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\WorkspaceManifest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\WorkspaceManifest\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKassel\\WorkspaceManifest\\WorkspaceManifestServiceProvider"
            ]
        }
    }
}
